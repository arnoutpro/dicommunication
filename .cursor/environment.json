{
  "name": "Dicommunication",
  "user": "ubuntu",
  "install": "pip install --break-system-packages -r requirements-dev.txt",
  "terminals": [
    {
      "name": "web",
      "command": "python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8080",
      "description": "FastAPI + HTMX web UI and JSON API on http://localhost:8080"
    }
  ],
  "ports": [
    { "name": "web", "port": 8080 },
    { "name": "mwl-scp", "port": 11112 }
  ]
}
