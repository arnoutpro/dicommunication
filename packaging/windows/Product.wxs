<?xml version="1.0" encoding="utf-8"?>
<?ifndef ProductVersion ?>
<?define ProductVersion = "0.3.0" ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Arnout.pro Dicommunication Tool"
      Manufacturer="Arnout.pro"
      Version="$(var.ProductVersion)"
      UpgradeCode="8f3c2a91-6d4e-4b17-9e5a-1c7d0f8a2b63"
      Language="1033"
      Scope="perMachine">
    <SummaryInformation Description="DICOM communication validator and PACS admin toolkit" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Dicommunication is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="packaging\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Dicommunication" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Arnout.pro" />
    </StandardDirectory>

    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="c4e91b07-2f6a-4d8e-9b31-7a5c0e12d844">
        <Shortcut
            Id="AppShortcut"
            Name="Dicommunication"
            Description="Open the Dicommunication workstation UI"
            Target="[INSTALLFOLDER]dicommunication.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
      <Component Id="DicomtagAnalyticsShortcut" Guid="872d86b2-9e7d-4ffa-bc2e-f2c97a7c1e9c">
        <Shortcut
            Id="VueAnalyticsShortcut"
            Name="Dicomtag Analytics"
            Description="Open Dicomtag Analytics (Study Root C-FIND)"
            Target="[INSTALLFOLDER]dicommunication.exe"
            Arguments="--profile dicomtag-analytics"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="vue_analytics"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Dicommunication" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!--
      The data directory (config, recent results, worklist) lives under
      %LOCALAPPDATA%, outside anything this MSI installs, so a plain
      uninstall never touches it. Ask once, on a genuine uninstall, whether
      to delete it too — SECURITY.md flags it as containing PHI in
      cleartext. UPGRADINGPRODUCTCODE excludes the RemoveExistingProducts
      step of an upgrade, which also sets REMOVE=ALL for the old version;
      UILevel excludes silent/unattended uninstalls, which must never block
      on a dialog nobody can answer.
    -->
    <CustomAction
        Id="PromptPurgeData"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[INSTALLFOLDER]dicommunication.exe&quot; --uninstall-cleanup"
        Execute="deferred"
        Return="ignore"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="PromptPurgeData" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 5
      </Custom>
    </InstallExecuteSequence>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\License.rtf" />
  </Package>
</Wix>
