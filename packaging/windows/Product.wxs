<?xml version="1.0" encoding="utf-8"?>
<?ifndef ProductVersion ?>
<?define ProductVersion = "0.3.0" ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Arnout.pro Dicommunication Tool"
      Manufacturer="Arnout.pro"
      Version="$(var.ProductVersion)"
      UpgradeCode="8f3c2a91-6d4e-4b17-9e5a-1c7d0f8a2b63"
      Language="1033"
      Scope="perMachine">
    <SummaryInformation Description="DICOM communication validator and PACS admin toolkit" />
    <!--
      AllowSameVersionUpgrades matters here: this MSI's version only changes
      when someone remembers to bump app/__init__.py's __version__ (the CI
      workflow otherwise reuses it for every manual build). Without this, a
      rebuild at an unchanged version gets a fresh auto-generated ProductCode
      and installs side by side with whatever's already there instead of
      replacing it — which is how a stale Start Menu shortcut survives every
      reinstall.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Dicommunication is already installed."
        AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="packaging\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Dicommunication" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Arnout.pro" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!--
      One product, one shortcut: Dicomtag Analytics, Dicom Anonymizer, Dicom
      Router, and Dicom Cleaner used to be separate Start-menu tools that
      passed their own profile flag to this same frozen dicommunication.exe
      and opened their own window at their own URL prefix. They're now
      reachable from this single window's own navigation instead, so
      there's only ever one shortcut to install.
    -->
    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="c4e91b07-2f6a-4d8e-9b31-7a5c0e12d844">
        <Shortcut
            Id="AppShortcut"
            Name="Dicommunication"
            Description="Open the Dicommunication workstation UI"
            Target="[INSTALLFOLDER]dicommunication.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <!--
          Explicit cleanup, independent of AllowSameVersionUpgrades above:
          delete every shortcut a pre-merge install could have left behind
          (including this tool's own former "Vue PACS Database Analytics"
          name) on every (re)install, so upgrading from a multi-shortcut
          version doesn't leave stale .lnk files pointing at a dead profile.
        -->
        <RemoveFile Id="RemoveStaleVueAnalyticsShortcut" Name="Vue PACS Database Analytics.lnk" On="install" />
        <RemoveFile Id="RemoveStaleDicomtagAnalyticsShortcut" Name="Dicomtag Analytics.lnk" On="install" />
        <RemoveFile Id="RemoveStaleAnonymizerShortcut" Name="Dicom Anonymizer.lnk" On="install" />
        <RemoveFile Id="RemoveStaleRouterShortcut" Name="Dicom Router.lnk" On="install" />
        <RemoveFile Id="RemoveStaleCleanerShortcut" Name="Dicom Cleaner.lnk" On="install" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Off by default (Level 1000, above the default INSTALLLEVEL of 1) but
      selectable in the feature tree — the Start Menu shortcut above already
      covers the common case, so a desktop shortcut is opt-in clutter.
    -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="DesktopShortcutDicommunication" Guid="262bd9d7-9290-4214-8ec5-c4e8b9977ce9">
        <Shortcut
            Id="DesktopAppShortcut"
            Name="Dicommunication"
            Description="Open the Dicommunication workstation UI"
            Target="[INSTALLFOLDER]dicommunication.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RemoveFile Id="RemoveStaleDesktopVueAnalyticsShortcut" Name="Dicomtag Analytics.lnk" On="install" />
        <RemoveFile Id="RemoveStaleDesktopAnonymizerShortcut" Name="Dicom Anonymizer.lnk" On="install" />
        <RemoveFile Id="RemoveStaleDesktopRouterShortcut" Name="Dicom Router.lnk" On="install" />
        <RemoveFile Id="RemoveStaleDesktopCleanerShortcut" Name="Dicom Cleaner.lnk" On="install" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="desktop_shortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Dicommunication" Title="Dicommunication" Level="1"
        Description="The Dicommunication workstation UI — network/DIMSE/HL7 tools, Dicomtag Analytics, Dicom Anonymizer, Dicom Router, and Dicom Cleaner all in one window.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="DicommunicationDesktop" Title="Desktop shortcut" Level="1000"
          Description="Add a Dicommunication shortcut on the Desktop, in addition to the Start Menu.">
        <ComponentRef Id="DesktopShortcutDicommunication" />
      </Feature>
    </Feature>

    <!--
      The data directory (config, recent results, worklist) lives under
      %LOCALAPPDATA%, outside anything this MSI installs, so a plain
      uninstall never touches it. Ask once, on a genuine uninstall, whether
      to delete it too — SECURITY.md flags it as containing PHI in
      cleartext. UPGRADINGPRODUCTCODE excludes the RemoveExistingProducts
      step of an upgrade, which also sets REMOVE=ALL for the old version;
      UILevel excludes silent/unattended uninstalls, which must never block
      on a dialog nobody can answer.
    -->
    <CustomAction
        Id="PromptPurgeData"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[INSTALLFOLDER]dicommunication.exe&quot; --uninstall-cleanup"
        Execute="deferred"
        Return="ignore"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom
          Action="PromptPurgeData"
          Before="RemoveFiles"
          Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 5' />
    </InstallExecuteSequence>

    <!--
      FeatureTree (not InstallDir): lets the setup wizard show Dicommunication
      and its Desktop-shortcut sub-feature as a checkbox tree via
      CustomizeDlg, which also has its own Browse button for INSTALLFOLDER.
    -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\License.rtf" />
  </Package>
</Wix>
