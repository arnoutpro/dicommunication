<?xml version="1.0" encoding="utf-8"?>
<?ifndef ProductVersion ?>
<?define ProductVersion = "0.3.0" ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Arnout.pro Dicommunication Tool"
      Manufacturer="Arnout.pro"
      Version="$(var.ProductVersion)"
      UpgradeCode="8f3c2a91-6d4e-4b17-9e5a-1c7d0f8a2b63"
      Language="1033"
      Scope="perMachine">
    <SummaryInformation Description="DICOM communication validator and PACS admin toolkit" />
    <!--
      AllowSameVersionUpgrades matters here: this MSI's version only changes
      when someone remembers to bump app/__init__.py's __version__ (the CI
      workflow otherwise reuses it for every manual build). Without this, a
      rebuild at an unchanged version gets a fresh auto-generated ProductCode
      and installs side by side with whatever's already there instead of
      replacing it — which is how a stale Start Menu shortcut survives every
      reinstall.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Dicommunication is already installed."
        AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="packaging\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Dicommunication" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Arnout.pro" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!--
      All three apps run from the same frozen dicommunication.exe (Dicomtag
      Analytics and Dicom Anonymizer just pass their own profile flag), so
      AppFiles is one shared ComponentGroup referenced by all three Features
      below rather than installed three times. Unchecking one app in the
      feature tree only removes that app's shortcuts; the shared files stay
      until all three are unchecked (Windows Installer reference-counts a
      component against every Feature that lists it).
    -->
    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="c4e91b07-2f6a-4d8e-9b31-7a5c0e12d844">
        <Shortcut
            Id="AppShortcut"
            Name="Dicommunication"
            Description="Open the Dicommunication workstation UI"
            Target="[INSTALLFOLDER]dicommunication.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
      <Component Id="DicomtagAnalyticsShortcut" Guid="872d86b2-9e7d-4ffa-bc2e-f2c97a7c1e9c">
        <Shortcut
            Id="VueAnalyticsShortcut"
            Name="Dicomtag Analytics"
            Description="Open Dicomtag Analytics (Study Root C-FIND)"
            Target="[INSTALLFOLDER]dicommunication.exe"
            Arguments="--profile dicomtag-analytics"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <!--
          Each app is now a separately selectable Feature, so this can be
          the only shortcut in ApplicationProgramsFolder (Dicommunication
          unchecked). RemoveFolder only deletes an empty folder, so this is
          safe alongside StartMenuShortcut's own RemoveFolder above when
          both are installed.
        -->
        <RemoveFolder Id="RemoveApplicationProgramsFolder2" On="uninstall" />
        <!--
          Explicit cleanup, independent of AllowSameVersionUpgrades above:
          this tool was named "Vue PACS Database Analytics" before it was
          Dicomtag Analytics. Delete that stale .lnk on every (re)install so
          side-by-side installs already on a machine get cleaned up too, not
          just future ones.
        -->
        <RemoveFile
            Id="RemoveStaleVueAnalyticsShortcut"
            Name="Vue PACS Database Analytics.lnk"
            On="install" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="vue_analytics"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
      <Component Id="AnonymizerShortcut" Guid="976af402-7bfa-4f91-8aae-f14686772159">
        <Shortcut
            Id="AnonymizerShortcutFile"
            Name="Dicom Anonymizer"
            Description="Open Dicom Anonymizer (query, retrieve, and anonymize studies)"
            Target="[INSTALLFOLDER]dicommunication.exe"
            Arguments="--profile dicom-anonymizer"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <!-- Same reasoning as DicomtagAnalyticsShortcut's RemoveFolder above. -->
        <RemoveFolder Id="RemoveApplicationProgramsFolder3" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="anonymizer"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Off by default (Level 1000, above the default INSTALLLEVEL of 1) but
      selectable in the feature tree — the Start Menu shortcuts above already
      cover the common case, so a desktop shortcut is opt-in clutter.
    -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="DesktopShortcutDicommunication" Guid="262bd9d7-9290-4214-8ec5-c4e8b9977ce9">
        <Shortcut
            Id="DesktopAppShortcut"
            Name="Dicommunication"
            Description="Open the Dicommunication workstation UI"
            Target="[INSTALLFOLDER]dicommunication.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="desktop_shortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutDicomtagAnalytics" Guid="2d141871-208c-417e-8779-c87fd52d32fc">
        <Shortcut
            Id="DesktopVueAnalyticsShortcut"
            Name="Dicomtag Analytics"
            Description="Open Dicomtag Analytics (Study Root C-FIND)"
            Target="[INSTALLFOLDER]dicommunication.exe"
            Arguments="--profile dicomtag-analytics"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="desktop_shortcut_vue_analytics"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutAnonymizer" Guid="949654d0-ef89-4118-a1a2-5fa05c3b99c4">
        <Shortcut
            Id="DesktopAnonymizerShortcut"
            Name="Dicom Anonymizer"
            Description="Open Dicom Anonymizer (query, retrieve, and anonymize studies)"
            Target="[INSTALLFOLDER]dicommunication.exe"
            Arguments="--profile dicom-anonymizer"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Arnout.pro\Dicommunication"
            Name="desktop_shortcut_anonymizer"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Dicommunication" Title="Dicommunication" Level="1"
        Description="The Dicommunication workstation UI (C-ECHO, C-STORE, C-FIND, worklist, HL7, Tag Editor).">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="DicommunicationDesktop" Title="Desktop shortcut" Level="1000"
          Description="Add a Dicommunication shortcut on the Desktop, in addition to the Start Menu.">
        <ComponentRef Id="DesktopShortcutDicommunication" />
      </Feature>
    </Feature>
    <Feature Id="DicomtagAnalytics" Title="Dicomtag Analytics" Level="1"
        Description="Study Root C-FIND / Vue-Tamar analytics tool (patient counts, report retrieve).">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DicomtagAnalyticsShortcut" />
      <Feature Id="DicomtagAnalyticsDesktop" Title="Desktop shortcut" Level="1000"
          Description="Add a Dicomtag Analytics shortcut on the Desktop, in addition to the Start Menu.">
        <ComponentRef Id="DesktopShortcutDicomtagAnalytics" />
      </Feature>
    </Feature>
    <Feature Id="DicomAnonymizer" Title="Dicom Anonymizer" Level="1"
        Description="Query, retrieve, and anonymize studies, series, or images.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AnonymizerShortcut" />
      <Feature Id="DicomAnonymizerDesktop" Title="Desktop shortcut" Level="1000"
          Description="Add a Dicom Anonymizer shortcut on the Desktop, in addition to the Start Menu.">
        <ComponentRef Id="DesktopShortcutAnonymizer" />
      </Feature>
    </Feature>

    <!--
      The data directory (config, recent results, worklist) lives under
      %LOCALAPPDATA%, outside anything this MSI installs, so a plain
      uninstall never touches it. Ask once, on a genuine uninstall, whether
      to delete it too — SECURITY.md flags it as containing PHI in
      cleartext. UPGRADINGPRODUCTCODE excludes the RemoveExistingProducts
      step of an upgrade, which also sets REMOVE=ALL for the old version;
      UILevel excludes silent/unattended uninstalls, which must never block
      on a dialog nobody can answer.
    -->
    <CustomAction
        Id="PromptPurgeData"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[INSTALLFOLDER]dicommunication.exe&quot; --uninstall-cleanup"
        Execute="deferred"
        Return="ignore"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom
          Action="PromptPurgeData"
          Before="RemoveFiles"
          Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 5' />
    </InstallExecuteSequence>

    <!--
      FeatureTree (not InstallDir): lets the setup wizard show the six
      features above as a checkbox tree (Dicommunication / Dicomtag
      Analytics / Dicom Anonymizer, each with a Desktop shortcut
      sub-feature) via CustomizeDlg, which also has its own Browse button
      for INSTALLFOLDER.
    -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\License.rtf" />
  </Package>
</Wix>
